# ---- Server ----
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# ---- Database (Postgres) ----
# Matches docker-compose.yml service "postgres"
DATABASE_URL=postgresql://nexusdial:nexusdial@localhost:5432/nexusdial?schema=public

# ---- Redis ----
REDIS_URL=redis://localhost:6379

# ---- JWT ----
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# ---- OTP ----
OTP_TTL_SECONDS=300
OTP_MAX_PER_WINDOW=3
OTP_WINDOW_SECONDS=600

# ---- Rate limiting (general API) ----
API_RATE_MAX=200
API_RATE_WINDOW_MS=900000

# ---- AI provider ----
# AI_PROVIDER one of: openai | mock
# When unset or no key provided, falls back to "mock" so the pipeline runs offline.
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-3.5-turbo

# ---- Queue / worker ----
INTELLIGENCE_MAX_ATTEMPTS=3
